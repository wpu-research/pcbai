@@ -45,7 +47,23 @@ type CompileView =
 
 const FLASH_MAX = 32256, RAM_MAX = 2048
 
-export function LabEditor({ initial, initialCode, allowedParts = DEFAULT_PARTS, lockedPartIds, goals, storageKey, onGoalsComplete, compact }: LabEditorProps) {
+const PCBAI_URL = process.env.NEXT_PUBLIC_PCBAI_URL || 'https://pcbai-web-production.up.railway.app'
+
+/** pcbai ile değiş tokuş biçimi: URL parçasında base64url JSON (sunucuya hiç gitmez). */
+function encodeBridge(x: unknown): string {
+  const bytes = new TextEncoder().encode(JSON.stringify(x))
+  let s = ''
+  for (const b of bytes) s += String.fromCharCode(b)
+  return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '')
+}
+function decodeBridge(s: string): { circuit?: unknown; code?: unknown } | null {
+  try {
+    const b64 = s.replace(/-/g, '+').replace(/_/g, '/')
+    return JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(b64), (c) => c.charCodeAt(0))))
+  } catch { return null }
+}
+
+export function LabEditor({ initial, initialCode, allowedParts = DEFAULT_PARTS, lockedPartIds, goals, storageKey, onGoalsComplete, compact, pcbBridge }: LabEditorProps) {
   const t = useT()
   const locale = useLocale()
   const tRef = useRef(t); tRef.current = t
@@ -109,6 +127,22 @@ export function LabEditor({ initial, initialCode, allowedParts = DEFAULT_PARTS,
     return () => clearTimeout(t)
   }, [circuit, code, storageKey, loaded])
 
+  // ---- pcbai köprüsü: #pcbai=<base64url JSON> ile gelen devre ve kod (Devre Atölyesi'nden) ----
+  useEffect(() => {
+    if (!pcbBridge || !loaded || !location.hash.startsWith('#pcbai=')) return
+    const got = decodeBridge(location.hash.slice(7))
+    history.replaceState(null, '', location.pathname + location.search)
+    if (!got || !isCircuit(got.circuit)) return
+    setCircuit(normalizeCircuit(got.circuit))
+    if (typeof got.code === 'string') setCode(got.code)
+    setFitKey((k) => k + 1)
+    say(tRef.current('lab.editor.pcbImported'))
+  }, [pcbBridge, loaded, say])
+  const toPcb = useCallback(() => {
+    const url = `${PCBAI_URL}/aktar#${encodeBridge({ v: 1, source: 'macademiax-lab', circuit: circuitRef.current, code: codeRef.current })}`
+    window.open(url, '_blank', 'noopener')
+  }, [])
+
   // ---- hedefler ----
   const analysis = useMemo(() => analyze(circuit), [circuit])
   const evalGoals = useCallback(() => {
@@ -342,6 +376,9 @@ export function LabEditor({ initial, initialCode, allowedParts = DEFAULT_PARTS,
                 type="button" className="lab-round" aria-pressed={muted} aria-label={muted ? t('lab.editor.unmute') : t('lab.editor.mute')} title={muted ? t('lab.editor.unmute') : t('lab.editor.mute')}
                 onClick={() => { const m = !isBuzzerMuted(); setBuzzerMuted(m); setMutedState(m) }}
               >{muted ? '🔇' : '🔊'}</button>
+              {pcbBridge && (
+                <button type="button" className="lab-pcb" data-testid="lab-to-pcb" onClick={toPcb} title={t('lab.editor.toPcbTitle')}>{t('lab.editor.toPcb')} ↗</button>
+              )}
             </div>
             <div className={`lab-meter${running && !paused ? ' on' : ''}`} role="status" aria-label={t('lab.editor.simStatus')}>
               <span className="lab-state" data-testid="lab-status">{statusText}</span>
